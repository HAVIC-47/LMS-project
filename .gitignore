# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Strapi
backend/.tmp/
backend/.cache/
backend/.strapi/
backend/build/
backend/dist/
# NOT ignored: generated types are committed on purpose. They are produced by
# `strapi ts:generate-types`, which boots Strapi and opens a database connection --
# something a build container cannot rely on. Without them in the repo, a clean clone
# type-checks against an empty schema registry and every documents() call fails.
backend/exports/
backend/*.db
backend/*.db-journal

# Next.js (Part 2 onwards)
frontend/.next/
frontend/out/
frontend/.vercel/

# Editors & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
