# The Strapi origin this Next server talks to. Server-side only: it is never exposed to
# the browser, which only ever calls /api/auth/* on this app.
STRAPI_URL=http://127.0.0.1:1337

# Set to false only when running a production build over plain HTTP (e.g. localhost).
# Leave unset in a real deployment: it defaults to on in production.
SECURE_COOKIES=
