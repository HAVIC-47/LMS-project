# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets — replace every one of these before deploying
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# How long a login stays valid. Short enough to limit a stolen token, long enough that a
# student is not logged out mid-lesson.
JWT_EXPIRES_IN=7d

# Database
# Local: SQLite, no setup required.
# Railway: attach a Postgres service and it injects DATABASE_URL — config/database.ts
# switches to Postgres automatically when that variable is present, so leave the rest unset.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgresql://user:password@host:5432/railway

# CORS — the frontend origin(s) allowed to call this API. Comma-separated.
# localhost:3000 is always allowed; add the Vercel URL here in production.
FRONTEND_URL=http://localhost:3000

# Demo data. Creates the four role accounts and a small course catalog on boot.
# Leave this off in production.
SEED_DEMO_DATA=true
SEED_PASSWORD=Passw0rd!23

# Promote this existing account to admin on boot. The account must already exist:
# this raises a signed-up user, it never creates one. Only ever promotes, never demotes.
BOOTSTRAP_ADMIN_EMAIL=
