{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question",
    "description": "One MCQ question. `correctIndex` is stripped before any student-facing response."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "prompt": {
      "type": "text",
      "required": true
    },
    "options": {
      "type": "json",
      "required": true
    },
    "correctIndex": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions"
    }
  }
}
