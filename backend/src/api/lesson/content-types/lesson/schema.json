{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "A single unit of course content: either written text or a video URL."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "contentType": {
      "type": "enumeration",
      "enum": ["text", "video"],
      "default": "text",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "videoUrl": {
      "type": "string"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons"
    },
    "progressRecords": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson-progress.lesson-progress",
      "mappedBy": "lesson"
    }
  }
}
